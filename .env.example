# API key de Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY="tu_gemini_api_key_aqui"

# Modelo de LLM a utilizar (ej. gemini-2.0-flash, gemini-1.5-pro, etc.)
MODEL="gemini-3.5-flash-lite"

# Configuración opcional para LangSmith (Tracing y monitoreo)
# LANGSMITH_TRACING="true"
# LANGSMITH_API_KEY="tu_langsmith_api_key_aqui"
# LANGSMITH_PROJECT="tu_nombre_de_proyecto_aqui"
