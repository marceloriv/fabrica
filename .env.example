# API key de Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY="tu_gemini_api_key_aqui"

# Modelo de LLM a utilizar (ej. gemini-2.0-flash, gemini-1.5-pro, etc.)
MODEL="gemini-3.5-flash-lite"

# Opcional: API key de Serper (https://serper.dev) para que el Especialista busque en la web.
# Sin esta variable, el Especialista funciona igual pero solo con el conocimiento del modelo.
# SERPER_API_KEY="tu_serper_api_key_aqui"

# Opcional: precios de Gemini en USD por millón de tokens, para el costo estimado que imprime
# el medidor de uso. Sin estas variables solo se muestra el conteo de tokens, sin costo.
# GEMINI_PRICE_INPUT_PER_1M="0.0"
# GEMINI_PRICE_OUTPUT_PER_1M="0.0"

# Configuración opcional para LangSmith (Tracing y monitoreo)
# LANGSMITH_TRACING="true"
# LANGSMITH_API_KEY="tu_langsmith_api_key_aqui"
# LANGSMITH_PROJECT="tu_nombre_de_proyecto_aqui"
